---
import Section from '../components/Section.astro'
import Eyebrow from '../components/Eyebrow.astro'
import { Image } from 'astro:assets'
import f1 from '../assets/alumnos/symun-2025-claret-6-2.jpg'
import f2 from '../assets/alumnos/symun-claret-carmen-2-1.jpg'
import f3 from '../assets/alumnos/symun-2025-claret-8-1.jpg'
import f4 from '../assets/alumnos/claret-3-1.jpg'
import f5 from '../assets/alumnos/symun-claret-cayetana-2-1.jpg'

// Cada foto se usa una sola vez en toda la página.
const fotos = [
  { src: f1, alt: 'Comité en pleno debate durante un Modelo de Naciones Unidas', clase: 'sm:col-span-2 sm:row-span-2 aspect-[4/3] sm:aspect-auto' },
  { src: f2, alt: 'Una alumna de Claret interviene ante el comité', clase: 'aspect-square' },
  { src: f3, alt: 'Alumno de Claret tomando notas durante una sesión', clase: 'aspect-square' },
  { src: f4, alt: 'Delegados trabajando juntos en una resolución', clase: 'aspect-square' },
  { src: f5, alt: 'Una alumna de Claret defiende su posición en el comité', clase: 'aspect-square' },
]
---
<Section bg="paper">
  <div class="max-w-[44ch]" data-reveal>
    <Eyebrow>Alumnos de Claret</Eyebrow>
    <h2 class="t-h2 font-display font-semibold" style="color:var(--ink)">Así se vive un MUN</h2>
  </div>

  <ul class="mt-10 grid grid-cols-2 gap-2.5 sm:grid-cols-4" role="list" data-reveal>
    {fotos.map((f) => (
      <li class:list={['overflow-hidden', f.clase]} style="border-radius:var(--radius-card)">
        <Image src={f.src} alt={f.alt} widths={[380, 640, 1000]}
               sizes="(min-width:640px) 30vw, 48vw"
               class="h-full w-full object-cover" loading="lazy" />
      </li>
    ))}
  </ul>
</Section>
